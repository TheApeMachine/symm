__global__ void mf_hydro_pack_v2(
    const float* rho,
    const float* mom,
    const float* thermal,
    MFHydroStateV2* out,
    unsigned* status,
    MFHydroParamsV2 p
) {
    unsigned i=blockIdx.x*blockDim.x+threadIdx.x;

    if (i>=p.n) return;
    MFHydroStateV2 s=mf_zero_state();
    s.q[0]=rho[i];
    for(unsigned a=0;a<3;++a) s.q[1+a]=mom[3*i+a];
    s.q[5]=thermal[i];
    s.q[4]=s.q[5]+mf_kinetic(s);
    unsigned st=mf_hydro_params_valid(p) ? mf_primitive(s,p).status : unsigned(MF_PHYSICS_BAD_PARAMETERS);
    if(s.q[5]<0) st=MF_PHYSICS_BAD_STATE;
    status[i]=st; out[i]=s;
}

__global__ void mf_hydro_unpack_v2(
    const MFHydroStateV2* in,
    float* rho,
    float* mom,
    float* thermal,
    unsigned* status,
    MFHydroParamsV2 p
) {
    unsigned i=blockIdx.x*blockDim.x+threadIdx.x;

    if (i>=p.n) return;
    MFPrimitive v=mf_primitive(in[i],p); status[i]=v.status;
    rho[i]=in[i].q[0];
    for(unsigned a=0;a<3;++a) mom[3*i+a]=in[i].q[1+a];
    thermal[i]=v.thermal;
}

