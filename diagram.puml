@startuml
skinparam shadowing false
skinparam DefaultFontName Arial

skinparam PartitionBorderColor #555555
skinparam PartitionFontColor #222222

skinparam ActivityBorderColor #666666
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontColor #222222

skinparam conditionStyle diamond


start


partition #FFFFFF "**Symm System Architecture**" {

    ' ============================================================
    ' TRANSPORT / INGRESS & INFRASTRUCTURE
    '
    ' Three Kraken websocket transports publish into the runtime.
    ' Raw wire frames are captured byte-for-byte before any stage
    ' reads them. Authoritative broker owners manage market facts.
    ' ============================================================

    partition #E3F2FD "**Ingress & Infrastructure**" {

        fork

            :public websocket\nticker / trade / book L2; <<input>>

        fork again

            :private websocket\nlevel3 / own executions; <<input>>

        fork again

            :futures websocket\nticker / trade; <<input>>

        end fork

        :Record raw wire capture\nbyte-for-byte per stream; <<save>>

        fork

            :Broker authoritative owners\nInstrument / Price / Balance; <<load>>

        fork again

            :Hindsight catalog storage\nIceberg tables / Envelope witnesses; <<save>>

        end fork

        :Seed instrument universe\nand initialize shared cognition engine; <<procedure>>
    }


    ' ============================================================
    ' WORKSPACE RING
    '
    ' The workspace is a Disruptor ring whose stages are nested
    ' concurrent workloads executed behind stage barriers.
    '
    '   stage1  observations   (signals + flow + classification + capture witness)
    '   stage2  grid & context (spatial impulse map + streaming temporal context)
    '   stage3  dual-track     (live canary & regulator + background rehearsal)
    '   stage4  ui & hindsight (realtime telemetry + historical causal query)
    ' ============================================================

    partition #F2F2F2 "**Workspace Ring**" {

        ' ----------------------------------------------------
        ' WORKSPACE STAGE 1 — OBSERVATIONS
        ' ----------------------------------------------------

        partition #FFFFFF "**stage1 — observations**" {

                partition #C8E6C9 "**Workload: signals**" {

                    partition #E8F5E9 "**stage1 (canonical microstructure signals)**" {

                        fork
                            :correlation;
                        fork again
                            :cvd\n(cumulative volume delta);
                        fork again
                            :depthflow;
                        fork again
                            :derivatives;
                        fork again
                            :hawkes\n(self-exciting arrival intensity);
                        fork again
                            :leadlag;
                        fork again
                            :liquidity;
                        fork again
                            :morphology;
                        fork again
                            :pumpdump;
                        fork again
                            :sentiment;
                        fork again
                            :toxicity;
                        end fork
                    }

                    partition #E8F5E9 "**stage2 (resonance & manifold)**" {

                        fork
                            :resonance dynamics\n& frequency projection;
                        fork again
                            :manifold\n(hydrodynamic flow field);
                        end fork
                    }
                }

            partition #FFE0B2 "**Workload: classification**" {

                partition #FFF3E0 "**stage1**" {
                    :category;
                }

                partition #FFF3E0 "**stage2**" {
                    :cognition beam\n& predictive class distribution;
                }
            }

            partition #CFD8DC "**Capture witness**" {

                :recording.Session.Step\npersist observation & precursor witness; <<save>>
            }
        }


        ' ----------------------------------------------------
        ' WORKSPACE STAGE 2 — GRID & TEMPORAL CONTEXT
        ' ----------------------------------------------------

        partition #FFFFFF "**stage2 — grid & temporal context**" {

            partition #E1BEE7 "**Impulse Map & Spatial Communities**" {

                :Receive completed observations\n(pure metrics from stage 1); <<input>>

                :Group measurements by symbol\nand advance grid.Space; <<task>>

                fork
                    :Directional affinity\n(co-movement slope); <<procedure>>
                fork again
                    :Continuity affinity\n(persistence over time); <<procedure>>
                fork again
                    :Quantum affinity\n(discrete step concordance); <<procedure>>
                fork again
                    :Phase affinity\n(lead/lag synchronization); <<procedure>>
                end fork

                :Compute node strength\n(Mahalanobis SNR + sample maturity); <<procedure>>

                :Build signed sympathy graph\n(attractive communities vs repulsive boundaries); <<procedure>>

                :Reconcile communities\nwith repulsive boundary pressure; <<procedure>>

                :Calculate region activation strength\n(SNR-weighted Otsu threshold); <<procedure>>

                :Emit grid.Impulse\n(active regions + Ready gate); <<output>>
            }

            partition #EDE7F6 "**Streaming Temporal Context**" {

                :Ingest active Region set into associative.Context; <<input>>

                :Append step regions to history buffer; <<task>>

                :Cap history to streaming sliding window\n(const maxHistory = 128 steps); <<procedure>>

                if (Sequence break detected in evaluation?) then (yes)

                    :Reset temporal context history\n(prevent stale cross-regime memory); <<procedure>>

                else (no)

                    :Retain sliding history window; <<procedure>>

                endif

                :Serialize Markov sensory sequence\n(R_t-k -> ... -> R_t-1 -> R_t); <<output>>
            }
        }


        ' ----------------------------------------------------
        ' WORKSPACE STAGE 3 — DUAL-TRACK LEARNING & EXECUTION
        ' ----------------------------------------------------

        partition #FFFFFF "**stage3 — agents & dual-track learning**" {

            fork

                ' ------------------------------------------------
                ' LIVE EXECUTION TRACK (Canary Agent 0 + MainAgent)
                ' ------------------------------------------------

                partition #FFCDD2 "**Live Execution Track**" {

                    if (Gated by impulse.Ready?) then (ready)

                        :Evaluate streaming context\nagainst shared cognition trie; <<procedure>>

                        :Enumerate legal actions\nFlat -> {ENTER, WAIT}\nHolding -> {EXIT, WAIT}; <<procedure>>

                        if (Unseen context / Support == 0?) then (yes)

                            :Deterministic ActionWait\n(zero gambling on live capital); <<procedure>>

                        else (empirical support exists)

                            :Select legal action with\nhighest evidence share; <<procedure>>

                        endif

                        :Emit ActionDecision\n(action, confidence, contrast, support); <<task>>

                        partition #FFEBEE "**MainAgent Execution Regulator**" {

                            if (Holding open position?) then (holding)

                                if (Decision == EXIT and Support > 0?) then (exit trigger)

                                    :Query Price.Surface(symbol, qty)\nfor authoritative visible bid depth; <<load>>

                                    if (Surface.FullyExecutable?) then (full lot executable)

                                        :Liquidate position at ExecutableVWAP\n(realize PnL and record actual exit fees); <<procedure>>

                                    else (insufficient depth)

                                        :Refuse fill (zero fill)\nprevent synthetic liquidation; <<procedure>>

                                    endif

                                else (continue holding)

                                    :Mark position to market\nupdate unrealized PnL; <<procedure>>

                                endif

                            else (flat)

                                if (canEnter: Decision == ENTER and Support > 0 and Status != learning?) then (enter qualified)

                                    :Query Price.Affordable and visible book ask depth; <<load>>

                                    if (Sufficient ask liquidity?) then (yes)

                                        :Open long position on book\n(deduct cash and record entry fees); <<procedure>>

                                    else (thin book)

                                        :Refuse entry (zero fill)\navoid adverse slippage; <<procedure>>

                                    endif

                                else (wait)

                                    :Scan for qualified precursor opportunities; <<procedure>>

                                endif

                            endif

                            :Update portfolio return statistics\n(mean return, variance, trade samples); <<procedure>>

                            if (Samples >= 10 and Mean - 2*StdErr > 0?) then (robust edge)

                                :Promote to trading status; <<procedure>>

                            else (negative / unproven edge)

                                :Maintain simulated / learning status\n(gate live capital entry); <<procedure>>

                            endif
                        }

                    else (forming)

                        :Emit ActionWait\nwhile impulse space calibrates; <<procedure>>

                    endif
                }

            fork again

                ' ------------------------------------------------
                ' BACKGROUND REHEARSAL TRACK (Worker Pool 1..N)
                ' ------------------------------------------------

                partition #C5CAE9 "**Background Rehearsal Track**" {

                    :Dedicated background loop\n(runs every 25ms in parallel goroutine); <<task>>

                    :Hindsight Discovery:\nScan market tape for confirmed excursion episodes; <<load>>

                    :Single-owner reader (hindsight.Resident):\nExtract actual captured precursor measurements; <<load>>

                    :Construct ReplayFragment:\nPure frames + out-of-band Prices & Surfaces; <<procedure>>

                    :Mount fragment into rehearsal worker; <<procedure>>

                    :Step historical frames through\nworker perception grid; <<procedure>>

                    :Enumerate legal actions\nFlat -> {ENTER, WAIT}\nHolding -> {EXIT, WAIT}; <<procedure>>

                    if (Unseen context / Support == 0?) then (yes)

                        :Uniform random exploration\n(symmetric uniform sampling with RNG); <<procedure>>

                    else (seen context)

                        if (Observed action has low share <= 0.5?) then (unseen alternative)

                            :Explore unobserved alternative action; <<procedure>>

                        else (high share)

                            :Follow empirical policy leader; <<procedure>>

                        endif

                    endif

                    partition #D1C4E9 "**Post-Hoc Fragment Evaluator**" {

                        :Score chosen action against\nobjective downstream reality; <<procedure>>

                        switch (Evaluated action)

                            case (ENTER)

                                :Evaluate entry correctness:\nDid move clear round-trip fees?\nWas cheaper entry available later?; <<procedure>>

                            case (EXIT)

                                :Evaluate exit correctness:\nDid exit protect before price drop or\nbid depth collapse (!FullyExecutable)?; <<procedure>>

                            case (WAIT)

                                :Counterfactual evaluation:\nScore opportunity cost or avoided loss\nrelative to taking alternative action; <<procedure>>

                        endswitch

                        :Compute signed reinforcement [-1, 1]\n(positive reinforces, negative inhibits); <<procedure>>
                    }

                    :sharedEngine.Observe(sequence, action, reinforcement)\nUpdate shared cognition model directly; <<save>>

                    :Reinforced policy immediately available\nto live canary agent and all workers; <<output>>
                }

            end fork
        }


        ' ----------------------------------------------------
        ' WORKSPACE STAGE 4 — UI SINK & HINDSIGHT SERVICES
        ' ----------------------------------------------------

        partition #FFFFFF "**stage4 — ui sink & hindsight services**" {

            fork

                partition #ECEFF1 "**Real-Time Dashboard Streaming**" {

                    :Non-blocking handoff to ui.Hub; <<procedure>>

                    fork

                        :WebSocket feed\n(telemetry, decisions, positions, trie modal); <<output>>

                    fork again

                        :WebRTC data channel\n(chunked fluid manifold state); <<output>>

                    end fork
                }

            fork again

                partition #CFD8DC "**Hindsight Historical API Services**" {

                    fork

                        :GET /hindsight/timeline\n(runs, episodes, regime shifts, excursions); <<output>>

                    fork again

                        :GET /hindsight/resident\n(causal backwards capture walk to resident metrics); <<output>>

                    fork again

                        :GET /hindsight/inspection\n(causal DAG links & precursor envelope payloads); <<output>>

                    end fork
                }

            end fork
        }
    }
}


stop

@enduml
