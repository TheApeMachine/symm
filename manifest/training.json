{
  "id": "training",
  "name": "training",
  "nodes": {
    "feed": {
      "id": "feed",
      "type": "websocket.WebSocketClient",
      "inputData": {
        "endpoint": { "value": "wss://ws.kraken.com/v2" }
      },
      "connections": {
        "inputs": {},
        "outputs": {
          "read": [{ "nodeId": "grid", "portName": "data" }]
        }
      }
    },
    "grid": {
      "id": "grid",
      "type": "store.Grid",
      "inputData": {
        "metric": { "value": "cognition" },
        "interests": { "value": "data.0.symbol,data.0.last" }
      },
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [{ "nodeId": "transition", "portName": "data" }]
        }
      }
    },
    "transition": {
      "id": "transition",
      "type": "temporal.Transition",
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [{ "nodeId": "associate", "portName": "current" }]
        }
      }
    },
    "associate": {
      "id": "associate",
      "type": "cognition.Associate",
      "connections": {
        "inputs": {},
        "outputs": {
          "current": [{ "nodeId": "reinforce", "portName": "classBytes" }]
        }
      }
    },
    "reinforce": {
      "id": "reinforce",
      "type": "cognition.Reinforce",
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [{ "nodeId": "attractor", "portName": "contextBytes" }]
        }
      }
    },
    "attractor": {
      "id": "attractor",
      "type": "cognition.Attractor",
      "connections": {
        "inputs": {},
        "outputs": {
          "class": [{ "nodeId": "classification", "portName": "class" }]
        }
      }
    },
    "classification": {
      "id": "classification",
      "type": "cognition.Classification",
      "connections": {
        "inputs": {},
        "outputs": {
          "winner": [{ "nodeId": "sink", "portName": "value" }]
        }
      }
    },
    "sink": {
      "id": "sink",
      "type": "sink",
      "connections": { "inputs": {}, "outputs": {} }
    }
  }
}
