        "outputs": {
          "out": [
            {
              "nodeId": "pairs",
              "portName": "data"
            },
            {
              "nodeId": "channels",
              "portName": "data"
            },
            {
              "nodeId": "rejection",
              "portName": "data"
            }
          ]
