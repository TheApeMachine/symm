{
  "id": "live_spot",
  "name": "Kraken USD spot discovery and market records",
  "nodes": {
    "socket": {
      "id": "socket",
      "type": "websocket.WebSocketClient",
      "inputData": {
        "endpoint": {
          "value": "wss://ws.kraken.com/v2"
        },
        "onConnect": {
          "value": "{\"method\":\"subscribe\",\"params\":{\"channel\":\"instrument\",\"snapshot\":true,\"include_tokenized_assets\":false}}"
        }
      },
      "connections": {
        "inputs": {
          "write_0": [
            {
              "nodeId": "ticker",
              "portName": "out"
            }
          ],
          "write_1": [
            {
              "nodeId": "trade",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "frame.generation": [
            {
              "nodeId": "generation",
              "portName": "unsigned"
            }
          ],
          "frame.read": [
            {
              "nodeId": "socket_received",
              "portName": "data"
            }
          ],
          "frame.receivedAt": [
            {
              "nodeId": "socket_received",
              "portName": "text"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "generation": {
      "id": "generation",
