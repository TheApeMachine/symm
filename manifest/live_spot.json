{
  "id": "live_spot",
  "name": "Kraken USD spot discovery and market records",
  "nodes": {
    "socket": {
      "id": "socket",
      "type": "websocket.WebSocketClient",
      "inputData": {
        "endpoint": {
          "value": "wss://ws.kraken.com/v2"
        },
        "onConnect": {
          "value": "{\"method\":\"subscribe\",\"params\":{\"channel\":\"instrument\",\"snapshot\":true,\"include_tokenized_assets\":false}}"
        }
      },
      "connections": {
        "inputs": {
          "write_0": [
            {
              "nodeId": "ticker",
              "portName": "out"
            }
          ],
          "write_1": [
            {
              "nodeId": "trade",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "frame.generation": [
            {
              "nodeId": "generation",
              "portName": "unsigned"
            }
          ],
          "frame.read": [
            {
              "nodeId": "socket_received",
              "portName": "data"
            }
          ],
          "frame.receivedAt": [
            {
              "nodeId": "socket_received",
              "portName": "text"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "generation": {
      "id": "generation",
      "type": "data.Insert",
      "inputData": {
        "path": {
          "value": "_connection"
        },
        "encoding": {
          "value": "uint64"
        }
      },
      "connections": {
        "inputs": {
          "unsigned": [
            {
              "nodeId": "socket",
              "portName": "frame.generation"
            }
          ],
          "data": [
            {
              "nodeId": "socket_received",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "pairs",
              "portName": "data"
            },
            {
              "nodeId": "channels",
              "portName": "data"
            }
          ]
        }
      },
      "x": 300,
      "y": 0
    },
    "pairs": {
      "id": "pairs",
      "type": "data.Iterate",
      "inputData": {
        "path": {
          "value": "data.pairs"
        },
        "whole": {
          "value": true
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "generation",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "all": [
            {
              "nodeId": "usd",
              "portName": "data"
            }
          ]
        }
      },
      "x": 600,
      "y": 0
    },
    "usd": {
      "id": "usd",
      "type": "data.Where",
      "inputData": {
        "path": {
          "value": "quote"
        },
        "value": {
          "value": "\"USD\""
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "pairs",
              "portName": "all"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "online",
              "portName": "data"
            }
          ]
        }
      },
      "x": 900,
      "y": 0
    },
    "online": {
      "id": "online",
      "type": "data.Where",
      "inputData": {
        "path": {
          "value": "status"
        },
        "value": {
          "value": "\"online\""
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "usd",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "symbols",
              "portName": "data"
            }
          ]
        }
      },
      "x": 1200,
      "y": 0
    },
    "ticker": {
      "id": "ticker",
      "type": "data.Insert",
      "inputData": {
        "data": {
          "value": "{\"method\":\"subscribe\",\"params\":{\"channel\":\"ticker\",\"snapshot\":true,\"event_trigger\":\"bbo\"}}"
        },
        "path": {
          "value": "params.symbol"
        }
      },
      "connections": {
        "inputs": {
          "json": [
            {
              "nodeId": "symbols",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "socket",
              "portName": "write_0"
            }
          ]
        }
      },
      "x": 2100,
      "y": 200
    },
    "trade": {
      "id": "trade",
      "type": "data.Insert",
      "inputData": {
        "data": {
          "value": "{\"method\":\"subscribe\",\"params\":{\"channel\":\"trade\",\"snapshot\":false}}"
        },
        "path": {
          "value": "params.symbol"
        }
      },
      "connections": {
        "inputs": {
          "json": [
            {
              "nodeId": "symbols",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "socket",
              "portName": "write_1"
            }
          ]
        }
      },
      "x": 0,
      "y": 400
    },
    "records": {
      "id": "records",
      "type": "data.Iterate",
      "inputData": {
        "path": {
          "value": "data"
        },
        "envelope": {
          "value": true
        }
      },
      "connections": {
        "inputs": {
          "data_0": [
            {
              "nodeId": "ticker_frames",
              "portName": "out"
            }
          ],
          "data_1": [
            {
              "nodeId": "trade_frames",
              "portName": "out"
            }
          ]
        },
        "outputs": {}
      },
      "x": 600,
      "y": 400
    },
    "channels": {
      "id": "channels",
      "type": "data.Insert",
      "inputData": {
        "path": {
          "value": "_channels"
        },
        "json": {
          "value": "{\"ticker\":\"ticker\",\"trade\":\"trade\"}"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "generation",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "ticker_frames",
              "portName": "data"
            },
            {
              "nodeId": "trade_frames",
              "portName": "data"
            }
          ]
        }
      },
      "x": 900,
      "y": 400
    },
    "ticker_frames": {
      "id": "ticker_frames",
      "type": "data.Filter",
      "inputData": {
        "path": {
          "value": "channel"
        },
        "operator": {
          "value": "=="
        },
        "threshold": {
          "value": 0
        },
        "referencePath": {
          "value": "_channels.ticker"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "channels",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data_0"
            }
          ]
        }
      },
      "x": 1200,
      "y": 400
    },
    "trade_frames": {
      "id": "trade_frames",
      "type": "data.Filter",
      "inputData": {
        "path": {
          "value": "channel"
        },
        "operator": {
          "value": "=="
        },
        "threshold": {
          "value": 0
        },
        "referencePath": {
          "value": "_channels.trade"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "channels",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data_1"
            }
          ]
        }
      },
      "x": 1500,
      "y": 400
    },
    "symbols": {
      "id": "symbols",
      "type": "data.Pluck",
      "inputData": {
        "path": {
          "value": "symbol"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "online",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "ticker",
              "portName": "json"
            },
            {
              "nodeId": "trade",
              "portName": "json"
            }
          ]
        }
      },
      "x": 1500,
      "y": 0
    },
    "socket_received": {
      "id": "socket_received",
      "type": "data.Insert",
      "width": 240,
      "height": 120,
      "x": 300,
      "y": 200,
      "inputData": {
        "path": {
          "value": "capture.receivedAt"
        },
        "encoding": {
          "value": "text"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket",
              "portName": "frame.read"
            }
          ],
          "text": [
            {
              "nodeId": "socket",
              "portName": "frame.receivedAt"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "generation",
              "portName": "data"
            }
          ]
        }
      }
    }
  }
}