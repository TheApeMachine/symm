{
  "id": "live_spot",
  "name": "Kraken USD spot discovery and market records",
  "nodes": {
    "socket": {
      "id": "socket",
      "type": "websocket.WebSocketClient",
      "inputData": {
        "endpoint": {
          "value": "wss://ws.kraken.com/v2"
        },
        "onConnect": {
          "value": [
            "{\"method\":\"subscribe\",\"params\":{\"channel\":\"instrument\",\"snapshot\":true,\"include_tokenized_assets\":false}}"
          ]
        }
      },
      "connections": {
        "inputs": {
          "write_0": [
            {
              "nodeId": "universe",
              "portName": "ready.ticker"
            }
          ],
          "write_1": [
            {
              "nodeId": "universe",
              "portName": "ready.trade"
            }
          ]
        },
        "outputs": {
          "frame.generation": [
            {
              "nodeId": "generation",
              "portName": "unsigned"
            }
          ],
          "frame.read": [
            {
              "nodeId": "socket_received",
              "portName": "data"
            }
          ],
          "frame.provenance": [
            {
              "nodeId": "socket_received",
              "portName": "json"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "generation": {
      "id": "generation",
      "type": "data.Insert",
      "inputData": {
        "path": {
          "value": "_connection"
        },
        "encoding": {
          "value": "uint64"
        }
      },
      "connections": {
        "inputs": {
          "unsigned": [
            {
              "nodeId": "socket",
              "portName": "frame.generation"
            }
          ],
          "data": [
            {
              "nodeId": "socket_received",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "channels",
              "portName": "data"
            },
            {
              "nodeId": "universe",
              "portName": "data"
            }
          ]
        }
      },
      "x": 300,
      "y": 0
    },
    "records": {
      "id": "records",
      "type": "data.Iterate",
      "inputData": {
        "path": {
          "value": "data"
        },
        "envelope": {
          "value": true
        },
        "indexPath": {
          "value": "capture.record"
        }
      },
      "connections": {
        "inputs": {
          "data_0": [
            {
              "nodeId": "ticker_frames",
              "portName": "out"
            }
          ],
          "data_1": [
            {
              "nodeId": "trade_frames",
              "portName": "out"
            }
          ]
        },
        "outputs": {}
      },
      "x": 600,
      "y": 400
    },
    "channels": {
      "id": "channels",
      "type": "data.Insert",
      "inputData": {
        "path": {
          "value": "_channels"
        },
        "json": {
          "value": "{\"ticker\":\"ticker\",\"trade\":\"trade\"}"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "generation",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "ticker_frames",
              "portName": "data"
            },
            {
              "nodeId": "trade_frames",
              "portName": "data"
            }
          ]
        }
      },
      "x": 900,
      "y": 400
    },
    "ticker_frames": {
      "id": "ticker_frames",
      "type": "data.Filter",
      "inputData": {
        "path": {
          "value": "channel"
        },
        "operator": {
          "value": "=="
        },
        "threshold": {
          "value": 0
        },
        "referencePath": {
          "value": "_channels.ticker"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "channels",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data_0"
            }
          ]
        }
      },
      "x": 1200,
      "y": 400
    },
    "trade_frames": {
      "id": "trade_frames",
      "type": "data.Filter",
      "inputData": {
        "path": {
          "value": "channel"
        },
        "operator": {
          "value": "=="
        },
        "threshold": {
          "value": 0
        },
        "referencePath": {
          "value": "_channels.trade"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "channels",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data_1"
            }
          ]
        }
      },
      "x": 1500,
      "y": 400
    },
    "socket_received": {
      "id": "socket_received",
      "type": "data.Insert",
      "width": 240,
      "height": 120,
      "x": 300,
      "y": 200,
      "inputData": {
        "path": {
          "value": "capture"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket",
              "portName": "frame.read"
            }
          ],
          "json": [
            {
              "nodeId": "socket",
              "portName": "frame.provenance"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "generation",
              "portName": "data"
            }
          ]
        }
      }
    },
    "universe": {
      "id": "universe",
      "type": "kraken.Universe",
      "inputData": {
        "quote": {
          "value": "USD"
        },
        "excluded": {
          "value": [
            "USD",
            "EUR",
            "GBP",
            "AUD",
            "CAD",
            "CHF",
            "JPY",
            "NZD",
            "USDT",
            "USDC",
            "DAI",
            "PYUSD",
            "FDUSD",
            "TUSD",
            "USDG",
            "USDE",
            "EURT",
            "EURC",
            "GUSD",
            "BUSD",
            "FRAX",
            "LUSD",
            "CUSD",
            "USD0",
            "USDS",
            "RLUSD",
            "UST"
          ]
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "generation",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "ready.ticker": [
            {
              "nodeId": "socket",
              "portName": "write_0"
            }
          ],
          "ready.trade": [
            {
              "nodeId": "socket",
              "portName": "write_1"
            }
          ]
        }
      }
    }
  }
}
