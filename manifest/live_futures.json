{
  "id": "live_futures",
  "name": "Kraken Futures ticker and trade records",
  "nodes": {
    "socket": {
      "id": "socket",
      "type": "websocket.WebSocketClient",
      "width": 280,
      "height": 172,
      "inputData": {
        "endpoint": {
          "value": "wss://futures.kraken.com/ws/v1"
        },
        "onConnect": {
          "value": "{\"event\":\"subscribe\",\"feed\":\"ticker\",\"product_ids\":[\"PI_XBTUSD\"]}"
        }
      },
      "connections": {
        "inputs": {
          "write_0": [
            {
              "nodeId": "trade_subscription",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "frame.read": [
            {
              "nodeId": "socket_received",
              "portName": "data"
            }
          ],
          "frame.receivedAt": [
            {
              "nodeId": "socket_received",
              "portName": "text"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "trade_subscription": {
      "id": "trade_subscription",
      "type": "store.Constant",
      "width": 280,
      "height": 172,
      "inputData": {
        "data": {
          "value": "{\"event\":\"subscribe\",\"feed\":\"trade\",\"product_ids\":[\"PI_XBTUSD\"]}"
        }
      },
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [
            {
              "nodeId": "socket",
              "portName": "write_0"
            }
          ]
        }
      },
      "x": 0,
      "y": 200
    },
    "records": {
      "id": "records",
      "type": "data.CanonicalizeFutures",
      "width": 280,
      "height": 172,
      "inputData": {},
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket_received",
              "portName": "out"
            }
          ]
        },
        "outputs": {}
      },
      "x": 300,
      "y": 0
    },
    "socket_received": {
      "id": "socket_received",
      "type": "data.Insert",
      "width": 240,
      "height": 120,
      "x": 300,
      "y": 200,
      "inputData": {
        "path": {
          "value": "capture.receivedAt"
        },
        "encoding": {
          "value": "text"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket",
              "portName": "frame.read"
            }
          ],
          "text": [
            {
              "nodeId": "socket",
              "portName": "frame.receivedAt"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data"
            }
          ]
        }
      }
    }
  }
}
