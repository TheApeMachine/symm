{
  "id": "live_futures",
  "name": "Kraken Futures ticker and trade records",
  "nodes": {
    "socket": {
      "id": "socket",
      "type": "websocket.WebSocketClient",
      "width": 280,
      "height": 172,
      "inputData": {
        "endpoint": {
          "value": "wss://futures.kraken.com/ws/v1"
        },
        "awaitHandshake": {
          "value": true
        }
      },
      "connections": {
        "inputs": {
          "onConnect": [
            {
              "nodeId": "products",
              "portName": "onConnect"
            }
          ],
          "connectedWrite": [
            {
              "nodeId": "products",
              "portName": "subscribe"
            }
          ]
        },
        "outputs": {
          "frame.read": [
            {
              "nodeId": "socket_received",
              "portName": "data"
            }
          ],
          "frame.provenance": [
            {
              "nodeId": "socket_received",
              "portName": "json"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "records": {
      "id": "records",
      "type": "kraken.Futures",
      "width": 280,
      "height": 172,
      "inputData": {},
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket_received",
              "portName": "out"
            }
          ],
          "products": [
            {
              "nodeId": "products",
              "portName": "self"
            }
          ]
        },
        "outputs": {
          "records": [
            {
              "nodeId": "record",
              "portName": "data"
            }
          ]
        }
      },
      "x": 300,
      "y": 0
    },
    "socket_received": {
      "id": "socket_received",
      "type": "data.Insert",
      "width": 240,
      "height": 120,
      "x": 300,
      "y": 200,
      "inputData": {
        "path": {
          "value": "capture"
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "socket",
              "portName": "frame.read"
            }
          ],
          "json": [
            {
              "nodeId": "socket",
              "portName": "frame.provenance"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "records",
              "portName": "data"
            }
          ]
        }
      }
    },
    "record": {
      "id": "record",
      "type": "data.Iterate",
      "width": 240,
      "height": 120,
      "x": 600,
      "y": 0,
      "inputData": {
        "path": {
          "value": ""
        }
      },
      "connections": {
        "inputs": {
          "data": [
            {
              "nodeId": "records",
              "portName": "records"
            }
          ]
        },
        "outputs": {}
      }
    },
    "discovery": {
      "id": "discovery",
      "type": "controlflow.Once",
      "inputData": {
        "trigger": {
          "value": true
        },
        "through": {
          "value": "{}"
        }
      },
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [
            {
              "nodeId": "instruments",
              "portName": "body"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "instruments": {
      "id": "instruments",
      "type": "http.HTTPClient",
      "inputData": {
        "url": {
          "value": "https://futures.kraken.com/derivatives/api/v3/instruments"
        },
        "method": {
          "value": "GET"
        }
      },
      "connections": {
        "inputs": {
          "body": [
            {
              "nodeId": "discovery",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "products",
              "portName": "instruments_0"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    },
    "products": {
      "id": "products",
      "type": "kraken.Products",
      "inputData": {},
      "connections": {
        "inputs": {
          "instruments_0": [
            {
              "nodeId": "instruments",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "onConnect": [
            {
              "nodeId": "socket",
              "portName": "onConnect"
            }
          ],
          "subscribe": [
            {
              "nodeId": "socket",
              "portName": "connectedWrite"
            }
          ],
          "self": [
            {
              "nodeId": "records",
              "portName": "products"
            }
          ]
        }
      },
      "x": 0,
      "y": 0
    }
  }
}
