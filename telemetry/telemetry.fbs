table EnvelopeFuturesTickerData {
  productId:string (required);
  symbol:string;
  hasBid:bool;
  bid:double;
  bidSize:double;
  hasAsk:bool;
  ask:double;
  askSize:double;
  hasLast:bool;
  last:double;
  openInterest:double;
  hasMarkPrice:bool;
  markPrice:double;
  hasIndexPrice:bool;
  indexPrice:double;
  hasFundingRate:bool;
  fundingRate:double;
  hasFundingRatePrediction:bool;
  fundingRatePrediction:double;
  volume:double;
  timestampNs:long;
}

table EnvelopeFuturesTradeData {
  productId:string (required);
  symbol:string;
  price:double;
  qty:double;
  side:string;
  type:string;
  uid:string;
  timestampNs:long;
}

table EnvelopeLevel3Order {
  event:string;
  orderId:string (required);
  hasLimitPrice:bool;
  limitPrice:double;
  hasOrderQty:bool;
  orderQty:double;
  timestampNs:long;
}

table EnvelopeLevel3Data {
  symbol:string (required);
  type:string;
  timestampNs:long;
  checksum:uint;
  bids:[EnvelopeLevel3Order];
  asks:[EnvelopeLevel3Order];
}

// EnvelopeBoundaryStamp mirrors one types.Envelope.Boundaries entry: the
// diagnostics node's own label, when it witnessed the envelope, and a running
// summary of how often and how regularly this exact stage runs. Boundaries is
// an ordered trace, so consecutive entries are a live topology edge and their
// atNs delta is that hop's latency; seqCount/avgGapNs/lastGapNs give per-stage
// rate and health directly, and backlog is real ring pressure (how many
// sequence numbers behind the Workload's producer this stage was) — no
// separate graph definition or queue instrumentation needed.
table EnvelopeBoundaryStamp {
  label:string (required);
  atNs:long;
  seqCount:long;
  avgGapNs:long;
  lastGapNs:long;
  backlog:long;
}

table EnvelopeState {
  key:string;
  typeId:ubyte;

  // Hindsight capture provenance: the exact raw external input this envelope
  // was parsed from, carried unchanged through the ring so a persisted
  // historical state can be joined back to its raw frame by identity.
  captureRun:string;
  captureSeq:ulong;
  captureStream:string;
  captureEpoch:ulong;
  captureStreamSeq:ulong;
  captureOrdinal:ulong;

  tickerData:EnvelopeTickerData;
  tradeData:EnvelopeTradeData;
  level3Data:EnvelopeLevel3Data;
  futuresTickerData:EnvelopeFuturesTickerData;
  futuresTradeData:EnvelopeFuturesTradeData;

  correlation:EnvelopeMeasurement;
  leadLag:EnvelopeMeasurement;
  liquidity:EnvelopeMeasurement;
  sentiment:EnvelopeMeasurement;
  cvd:EnvelopeMeasurement;
  depthFlow:EnvelopeMeasurement;
  morphology:EnvelopeMeasurement;
  hawkes:EnvelopeMeasurement;
  pumpDump:EnvelopeMeasurement;
  toxicity:EnvelopeMeasurement;
  derivatives:EnvelopeMeasurement;

  categories:[EnvelopeCategory];
  opportunities:[EnvelopeOpportunityCandidate];
  graphUpdate:EnvelopeGraphUpdate;
  resonance:EnvelopeResonanceArtifact;
  manifold:EnvelopeManifoldState;
  cognition:EnvelopeCognition;
  boundaries:[EnvelopeBoundaryStamp];

  strategy:StrategyFrame;
  perspectives:[PerspectiveFrame];
  tick:long;

  // The account valuation as of this envelope. It rides the envelope rather
  // than a frame of its own so a reconnecting dashboard recovers the balance
  // from the next market event, instead of waiting for a broker poll it has
  // no way to trigger.
  equity:EquityFrame;
}

table EnvelopeStateFrame { state:EnvelopeState (required); }

union Frame {
  MeasurementsFrame,
  TickFrame,
  EquityFrame,
  BalancesFrame,
  ResonanceFrame,
  CognitionFrame,
  CausalFrame,
  GraphFrame,
  StrategyFrame,
  PositionsFrame,
  RegulatorFrame,
  ErrorFrame,
  FluidPhaseFrame,
  DiagnosticsFrame,
  ManifoldFrame,
  EnvelopeStateFrame
}

table Envelope {
  sequence:ulong;
  frame:Frame (required);
}

table FrameEntry { frame:Frame (required); }
table Batch {
  sequence:ulong;
  frames:[FrameEntry] (required);
}

root_type Envelope;
file_identifier "SYMM";
