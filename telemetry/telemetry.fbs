// Live learning owners serialized directly; no independently computed view state.
table LearningPrior { defined:bool; mean:double; variance:double; varianceDefined:bool; samples:ulong; support:double; authority:double; provisional:bool; maturity:double; evidenceAuthority:double; depth:int; contextLength:int; pending:ulong; memory:double; }
table LearningAction { kind:string; power:int; reduce:bool; prior:LearningPrior; }
table LearningDecision {
 id:ulong; agent:int; symbol:string; atNs:long; throughNs:long;
 context:[string]; action:LearningAction;
 quantity:string;
 tape:double; hasTape:bool;
}
table LearningAgent {
 id:int; initial:string; cash:string; equity:string; fees:string;
 profit:string; wealth:double; realized:string; unrealized:string;
 decisions:ulong; fills:ulong; pending:ulong;
 wins:ulong; losses:ulong; status:string;
 positions:[Position]; last:LearningDecision; alternatives:[LearningAction]; reading:LearningPrior; reward:double; elapsedNs:long; outcome:LearningDecision;
 // episode counts wallet renewals: an explorer whose cash fell under the venue
 // minimum is refunded and keeps trading. carried is the wealth of the episodes
 // already closed, so wealth + carried is the agent's whole record.
 episode:ulong (deprecated); carried:double (deprecated);
 // open is how many symbols this wallet currently holds, against
 // MaxConcurrentPositions.
 open:int;
}
table LearningRegion { id:ulong; condition:ulong; level:double; change:double; strength:double; authority:double; members:int; }
table LearningQuantity { source:string; label:string; x:double; y:double; value:double; activity:double; quality:double; present:bool; }
table LearningDevelopment {
 symbol:string; atNs:long; status:string; decisions:ulong;
 context:[string]; regions:[LearningRegion]; quantities:[LearningQuantity]; fromNs:long;
 // depth is the number of distinct grid states the context spans, bounded by
 // MaxTemporalContextDepth. context flattens their conditions, so its length
 // counts tokens rather than transitions.
 depth:int;
}
// Original rehearsal counters: pool counts are per pass, trained is cumulative.
table LearningRehearsal {
 status:string; workers:int; episodes:ulong; profitable:ulong; subfriction:ulong;
 declining:ulong; ungraded:ulong; unsupported:ulong; perWorker:ulong;
 decisions:ulong; trained:ulong; passes:ulong;
 lastSymbol:string; lastAction:string; lastReturn:double;
  lastFailure:string;
 illiquid:ulong; quiet:ulong;
 // warming counts observations a worker was not asked about because its own
 // grid had not formed regions yet. It is separate from unsupported, which
 // counts observations that carried no captured precursor at all: one is the
 // worker warming up, the other is missing evidence.
 warming:ulong;
 // What the archive actually supplied: how many recorded runs were read and
 // how many captured observations are resident against the budget.
 runs:int; observations:ulong; budget:ulong;
 // Runs the record held but could not supply. A truncated parquet is skipped
 // and counted here rather than becoming the learning phase: the walk carries
 // on, and the dashboard reports what was missed instead of showing nothing.
 skipped:int; lastSkip:string;
 // One track per replay worker: the tape it is actually playing back now.
 tracks:[LearningTrack];
}
// One retained observation of a mounted fragment. An observation the declared
// market coordinate is undefined at is absent, never zero.
table LearningStep { atNs:long; value:double; defined:bool; }
// A decision the worker took on the mounted fragment, positioned by the
// observation index it was taken at. value/graded arrive when the evaluation
// resolves, so an ungraded mark stays visibly ungraded.
table LearningMark { id:ulong; index:int; kind:string; power:int; reduce:bool; value:double; graded:bool; verdict:string; }
/*
LearningTrack is one worker's mounted tape fragment. steps is the captured
series, decimated by stride only for delivery; index and length stay in the
original observation coordinates, and marks position against them.
*/
table LearningTrack {
 id:int; symbol:string; index:int; length:int; queued:int; stride:int;
 steps:[LearningStep]; marks:[LearningMark];
 // The moments this tape is asking the worker to recognise: entry is the
 // observation the excursion ignited at and exit the one it reached its
 // extremum at. Both are -1 on a tape carrying no moment at all.
 entry:int; exit:int;
 // What the record says this tape did, in the same words the episode pool is
 // counted in. It describes the tape, never the call made on it.
 opportunity:string;
}
// What a precursor learner has actually recognised. These describe the tape and
// the memory built from it, never an account: an agent here holds no position,
// pays no fee and owns no wallet, and reporting one would be describing
// something that does not exist.

// One moment the record put on an observation, and how many distinct situations
// the agent has learned under it.
table LearningMoment { name:string (required); links:int; }

// One region the grid formed, as the agent was shown it.
table LearningActive { id:ulong; condition:ulong; strength:double; authority:double; members:int; }

// One question put to an agent's memory and the answer it gave back. Support is
// how much evidence stood behind the answer, and contrast how far ahead of the
// next answer it was: a winner at zero contrast is a tie, not a decision.
table LearningAnswer {
 asked:string; answered:string; runnerUp:string;
 confidence:double; contrast:double; ambiguity:double; support:ulong;
}

// One learner. Links is everything it has committed to memory.
table LearningLearner {
 id:int; links:int; moments:[LearningMoment]; answers:[LearningAnswer];
 // What this learner actually holds, as the prefix tree Cortex draws: the
 // moments it has learned about and, under each, the region sequences that
 // ran into them. Same node shape as the sensory tree, same renderer.
 branches:[CognitionBranch];
}

// The grid as the learners are being shown it.
table LearningGrid {
 symbol:string; formed:bool; columns:int; version:ulong; moment:string;
 regions:[LearningActive];
}

table LearningRecognition {
 atNs:long; fragments:int; frames:ulong; grid:LearningGrid; learners:[LearningLearner];
}

table LearningState {
 atNs:long; steps:ulong; decisions:ulong; resolved:ulong;
 status:string; agents:[LearningAgent]; markets:[LearningDevelopment]; restored:bool;
 // episodes totals the explorer wallet renewals across the swarm. forced counts
 // decisions released instead of trained because only one action was feasible.
 episodes:ulong (deprecated); forced:ulong (deprecated); rehearsal:LearningRehearsal;
 // What the precursor learners recognised. The wallet-shaped fields above
 // describe a model that no longer exists; this one describes the one that does.
 recognition:LearningRecognition;
}

union Frame {
  MeasurementsFrame,
  TickFrame,
  EquityFrame,
  BalancesFrame,
  ResonanceFrame,
  CognitionFrame,
  CausalFrame,
  GraphFrame,
  StrategyFrame,
  PositionsFrame,
  RegulatorFrame,
  ErrorFrame,
  FluidPhaseFrame,
  DiagnosticsFrame,
  ManifoldFrame
}

table Message {
  sequence:ulong;
  frame:Frame (required);
}

table FrameEntry { frame:Frame (required); }
table Batch {
  sequence:ulong;
  frames:[FrameEntry] (required);
}

root_type Message;
file_identifier "SYMM";
