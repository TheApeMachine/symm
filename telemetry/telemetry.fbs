table ManifoldReading {
  divergence:double;
  guidanceSpeed:double;
  coherenceMag2:double;
  pressureGradNorm:double;
  viscosityProxy:double;
  kuramotoR:double;
}

/*
ManifoldFrame carries the resident sensorium State and Reading exactly as
logic/manifold.Solver.Step returns them, field for field. It is built only at
the WebRTC transport boundary, from the *manifold.State every Step produces;
nothing upstream of that boundary encodes or shapes this data.
*/
table ManifoldFrame {
  sequence:ulong;
  n:long;
  bytes:[long] (required);
  seqs:[long] (required);
  tokenIds:[long] (required);
  contentIds:[long] (required);
  phase:[float] (required);
  omega:[float] (required);
  energy:[float] (required);
  mass:[float] (required);
  heat:[float] (required);
  amp:[float] (required);
  pos:[float] (required);
  vel:[float] (required);
  clamped:[bool] (required);
  dark:[bool] (required);
  reading:ManifoldReading (required);
  gridX:int;
  gridY:int;
  gridZ:int;
  gridSpacing:double;
  momRho:[float] (required);
  fieldEnergy:[float] (required);
  waveReal:[float] (required);
  waveImag:[float] (required);
  densityScale:float;
  momentumScale:float;
  energyScale:float;
  waveScale:float;
  modes:[WaveMode] (required);
}

table WaveMode { omega:float; real:float; imaginary:float; linewidth:float; }
table PhaseOutcome { direction:string; returnValue:double; horizon:long; }
table PhaseResponse {
  angle:double;
  similarity:double;
  observedAt:string;
  outcome:PhaseOutcome (required);
}
table Hydrodynamics {
  pressureGradNorm:double;
  divergence:double;
  coherenceMag2:double;
  guidanceSpeed:double;
  viscosityProxy:double;
  kuramotoR:double;
  kuramotoPsi:double;
}
table FluidPhaseFrame {
  source:string (required);
  at:long;
  phaseReady:bool;
  phaseReason:string;
  wave:[WaveMode] (required);
  hydrodynamics:Hydrodynamics (required);
  phaseScan:[PhaseResponse];
}

table DiagnosticClock {
  name:string (required);
  count:ulong;
  totalNs:ulong;
  lastNs:ulong;
  maxNs:ulong;
  lastAtNs:long;
  active:ulong;
  startedNs:long;
}
table DiagnosticHop {
  from:string (required);
  to:string (required);
  count:ulong;
  totalNs:ulong;
  lastNs:ulong;
  maxNs:ulong;
}
table DiagnosticQueue {
  name:string (required);
  kind:string (required);
  writers:[string] (required);
  readers:[string] (required);
  depth:ulong;
  capacity:ulong;
  highWater:ulong;
  symbols:ulong;
}
table DiagnosticError {
  source:string (required);
  message:string (required);
  caller:string;
  atNs:long;
}
table DiagnosticPass {
  state:string (required);
  inFlightNs:long;
  lastPassNs:long;
  sinceLastNs:long;
}
table DiagnosticGoroutine {
  owner:string (required);
  count:long;
  state:string;
}
table DiagnosticsFrame {
  status:string (required);
  enabled:bool;
  atNs:long;
  startedNs:long;
  stages:[DiagnosticClock] (required);
  hops:[DiagnosticHop] (required);
  queues:[DiagnosticQueue] (required);
  errors:[DiagnosticError] (required);
  pass:DiagnosticPass (required);
  goroutines:[DiagnosticGoroutine];
}

// ---------------------------------------------------------------------------
// EnvelopeState mirrors types.Envelope field-for-field, exactly as it exists
// on the workspace ring at an Observe boundary. It is not a curated view: an
// Observe node encodes the Envelope's own exported state, and consumers read
// the fields that are actually populated for the workload that produced it
// (a Ticker envelope carries Correlation/LeadLag/Liquidity/Categories; a
// Level3 envelope carries DepthFlow/Morphology; and so on). Unexported solver
// state with nothing to mirror (e.g. the resonance manifold's internal
// matrices) is absent because there is nothing to encode, not because it was
// curated away.
// ---------------------------------------------------------------------------

table EnvelopeMetric {
  label:string (required);
  raw:double;
  hasNormalized:bool;
  normalized:double;
  hasStandardized:bool;
  standardized:double;
  unit:string;
  timescale:string;
}

table EnvelopeMeasurementMetric { key:string (required); value:EnvelopeMetric (required); }

table EnvelopeMeasurement {
  id:string;
  label:string;
  source:string;
  seqIdx:long;
  atNs:long;
  hasFrom:bool;
  fromNs:long;
  maturity:double;
  snr:double;
  snrDefined:bool;
  metrics:[EnvelopeMeasurementMetric];
  metadata:[NamedNumber];
  provenance:[NamedString];
}

table EnvelopeCategory {
  atNs:long;
  symbol:string;
  type:string;
  confidence:double;
  surprisal:double;
  strength:double;
  maturity:double;
  uncertainty:double;
  freshness:double;
  supporting:[string];
  opposing:[string];
  missing:[string];
}

table EnvelopeGraphUpdate { symbol:string (required); atNs:long; }

table EnvelopeCognitionBranch {
  id:long;
  parentId:long;
  token:string;
  prefix:string;
  key:string;
  depth:long;
  probability:double;
  count:ulong;
}
table EnvelopeCognitionBeam { sequence:string; key:string; score:double; }
table EnvelopeCognitionClass { name:string; probability:double; }
table EnvelopeCognitionContribution { token:string; bits:double; }
table EnvelopeCognitionSymbol { symbol:string; className:string; score:double; purity:double; }
table EnvelopeCognitionLexical { original:string; mapped:string; similarity:double; }
table EnvelopeCognitionPrediction { key:string (required); value:double; }

table EnvelopeCognition {
  source:string;
  symbol:string;
  atNs:long;
  sequence:string;
  regimePrefix:string;
  winner:string;
  winnerClass:string;
  candidateWinner:string;
  stateHeld:bool;
  predictionsHeld:bool;
  switchConfidence:double;
  switchThreshold:double;
  error:string;
  confidence:double;
  classConfidence:double;
  contrast:double;
  contrastEvidence:double;
  hasEntropyBits:bool;
  entropyBits:double;
  hasEntropyThreshold:bool;
  entropyThreshold:double;
  ambiguous:bool;
  cohort:ulong;
  lookaheadScore:double;
  lookaheadPaths:long;
  beamWidth:long;
  maxHops:long;
  nodeCount:long;
  predictions:[EnvelopeCognitionPrediction];
  branches:[EnvelopeCognitionBranch];
  beams:[EnvelopeCognitionBeam];
  classes:[EnvelopeCognitionClass];
  remFromNs:long;
  remThroughNs:long;
  remReplays:long;
  remDecayFactor:double;
  remInhibitionPct:double;
  remConsolidating:bool;
  interpolatedSurprisal:double;
  contributions:[EnvelopeCognitionContribution];
  symbols:[EnvelopeCognitionSymbol];
  lexical:[EnvelopeCognitionLexical];
  dreams:[string];
}

// EnvelopeAnyValue mirrors one value out of a Go `map[string]any` (currently
// only CausalOutput.Rows) — a closed union over the concrete types that map
// is ever populated with, not a schema invented for the map's shape.
union EnvelopeAnyValue { NamedNumber, NamedString, EnvelopeNamedInt, EnvelopeNamedTimeNs, EnvelopeNamedFloatMatrix }
table EnvelopeNamedInt { name:string (required); value:long; }
table EnvelopeNamedTimeNs { name:string (required); valueNs:long; }
table EnvelopeFloatRow { values:[double] (required); }
table EnvelopeNamedFloatMatrix { name:string (required); rows:[EnvelopeFloatRow] (required); }
table EnvelopeAnyEntry { key:string (required); value:EnvelopeAnyValue (required); }

table EnvelopeReturnForecastDistribution {
  value:double;
  scale:double;
  degreesOfFreedom:double;
  ready:bool;
  innovation:double;
  reset:bool;
}

table EnvelopeReturnForecast {
  distribution:EnvelopeReturnForecastDistribution (required);
  horizon:long;
  candidateCall:double;
  call:double;
  stableCall:double;
  held:bool;
  switchConfidence:double;
  switchThreshold:double;
}

// EnvelopeFrame mirrors nomagique/types.Frame: a sparse fixed-slot vector.
// Data carries every slot dense (zero where unset); Mask is the same bitset
// the solver uses to distinguish "unset" from "set to zero".
table EnvelopeFrame { mask:[ulong] (required); data:[double] (required); }

table EnvelopeResonanceArtifact {
  symbol:string (required);
  atNs:long;
  forecast:EnvelopeReturnForecast;
  dynamics:EnvelopeFrame;
  forwardCurve:[double];
  forwardRetention:[double];
  supportedHorizon:long;
  calibrated:bool;
  resolvedSteps:long;
  readout:[double];
  confidence:double;
  lastResolutionTarget:double;
  lastResolutionError:double;
}

table EnvelopeSensoriumState {
  n:long;
  bytes:[long];
  seqs:[long];
  tokenIds:[long];
  contentIds:[long];
  phase:[float];
  omega:[float];
  energy:[float];
  mass:[float];
  heat:[float];
  amp:[float];
  pos:[float];
  vel:[float];
  clamped:[bool];
  dark:[bool];
}

table EnvelopeSensoriumReading {
  divergence:double;
  guidanceSpeed:double;
  coherenceMag2:double;
  pressureGradNorm:double;
  viscosityProxy:double;
  kuramotoR:double;
}

table EnvelopeWaveMode { omega:float; real:float; imaginary:float; linewidth:float; }

table EnvelopeManifoldState {
  state:EnvelopeSensoriumState (required);
  reading:EnvelopeSensoriumReading (required);
  gridX:long;
  gridY:long;
  gridZ:long;
  gridSpacing:double;
  momRho:[float];
  fieldEnergy:[float];
  waveReal:[float];
  waveImag:[float];
  densityScale:float;
  momentumScale:float;
  energyScale:float;
  waveScale:float;
  modes:[EnvelopeWaveMode];
}

table EnvelopeExcursion { low:double; mid:double; high:double; }

table EnvelopeOpportunityEconomics {
  calibrated:bool;
  transitionProbability:double;
  profitFirst:double;
  favorableExcursion:EnvelopeExcursion;
  adverseExcursion:EnvelopeExcursion;
  resolutionNs:long;
