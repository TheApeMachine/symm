}

// Retired with the advisor/planner/stoploss decision path. The slots stay
// reserved and the tables stay declared because Hindsight decodes historical
// captures that still carry them: deleting a field would shift every later
// vtable slot and silently misread stored history. Nothing writes them.
table MCTSBranch {
  action:string;
  visits:long;
  meanReward:double;
  blendedValue:double;
  rewardStd:double;
  counterfactualReward:double;
  counterfactualMass:double;
  counterfactualMean:double;
  effectiveVisits:double;
  causalExpectation:double;
  causalExpectationDefined:bool;
  pruned:bool;
}
table MCTSNode {
  action:long;
  actionName:string;
  depth:long;
  visits:long;
  effectiveVisits:double;
  observedReward:double;
  counterfactualReward:double;
  counterfactualMass:double;
  counterfactualPrecision:double;
  totalReward:double;
  meanReward:double;
  exploitation:double;
  exploration:double;
  causalExpectation:double;
  selectionScore:double;
  scmReady:bool;
  scmReason:string;
  selected:bool;
  principal:bool;
  blendedValue:double;
  rewardStd:double;
  causalExpectationDefined:bool;
  pruned:bool;
  state:[NamedNumber];
  children:[MCTSNode];
}
// Retired with the advisor/planner/stoploss decision path. The slots stay
// reserved and the tables stay declared because Hindsight decodes historical
// captures that still carry them: deleting a field would shift every later
// vtable slot and silently misread stored history. Nothing writes them.
table AdvisorClass {
  state:string;
  probability:double;
}
table AdvisorMoveMass {
  move:string;
  mass:double;
}
table AdvisorOpinion {
  advisor:string;
  state:string;
  probability:double;
  credibility:double;
  weight:double;
  // The advisor's whole reading. A single top probability cannot say whether
  // it was decisive or nearly split between two incompatible classes.
  classes:[AdvisorClass];
  maturity:double;
  // The move mass this advisor alone placed, before normalization.
  contribution:[AdvisorMoveMass];
  // Classes of this advisor that no projection rule accepted, whose weight
  // therefore never reached the consensus.
  unmapped:[string];
  // Classes this advisor declares but could not measure, whose evidence was
  // incomplete. They took no part in the distribution.
  unscored:[string];
  // The clock window this reading is valid over, against the coordinate the
  // council currently stands at.
  clock:string;
  leaseFrom:ulong;
  leaseUntil:ulong;
  clockNow:ulong;
}
// Why an advisor contributed nothing to a round. Silence had one rendering and
// two entirely different causes: evidence that never completed, and a reading
// that has since expired. Only the first is a fault.
table AdvisorSilence {
  advisor:string;
  reason:string;
  missing:[string];
  declared:int;
  leaseUntil:ulong;
  clockNow:ulong;
}
// Retired with the advisor/planner/stoploss decision path. The slots stay
// reserved and the tables stay declared because Hindsight decodes historical
// captures that still carry them: deleting a field would shift every later
// vtable slot and silently misread stored history. Nothing writes them.
table DecisionTrace {
  identificationStatus:string;
  decisionUnavailable:bool;
  expectedOutcome:double;
  outcomeUncertainty:double;
  horizon:long;
  explorationConstant:double;
  uncertaintyWeight:double;
  transitionSource:string;
  consensusDominantMove:string;
  consensusConfidence:double;
  consensusParticipants:long;
  // The council's full move distribution, keyed by move name. The dominant
  // move alone hides whether the winner led by a nose or a mile.
  consensusProbabilities:[NamedNumber];
  vetoes:[string];
  synergies:[string];
  iterations:long;
  branches:[MCTSBranch];
  recommendedAction:string;
  tree:MCTSNode;
  // How far and how wide the search actually got. Both are computed on every
  // round; without them an operator cannot tell a deep considered search from
  // one that fanned out twice and stopped.
  maxDepth:long;
  totalNodes:long;
  advisors:[AdvisorOpinion];
  advisorSilences:[AdvisorSilence];
  consensusUnmappedClasses:[string];
}
