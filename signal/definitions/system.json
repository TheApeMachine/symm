{
  "id": "system:orchestration",
  "name": "system:orchestration",
  "nodes": {
    "sub_message": {
      "id": "sub_message",
      "type": "transport.Message",
      "inputData": {
        "message": {
          "method": "subscribe",
          "params": {
            "channel": "trade",
            "symbol": [
              "BTC/USD",
              "ETH/USD"
            ]
          }
        }
      },
      "connections": {
        "inputs": {},
        "outputs": {
          "out": [
            {
              "nodeId": "ingress",
              "portName": "in"
            }
          ]
        }
      }
    },
    "ingress": {
      "id": "ingress",
      "type": "transport.WSStream",
      "inputData": {
        "_config": {
          "endpoint": "wss://ws.kraken.com/v2",
          "pace": "500ms"
        }
      },
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "sub_message",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "signals",
              "portName": "in"
            }
          ]
        }
      }
    },
    "signals": {
      "id": "signals",
      "type": "definition:signals",
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "ingress",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "logic",
              "portName": "in"
            }
          ]
        }
      }
    },
    "logic": {
      "id": "logic",
      "type": "definition:logic",
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "signals",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "ui",
              "portName": "in"
            }
          ]
        }
      }
    },
    "ui": {
      "id": "ui",
      "type": "ui.Broadcast",
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "logic",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "execution",
              "portName": "in"
            }
          ]
        }
      }
    },
    "execution": {
      "id": "execution",
      "type": "definition:execution",
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "ui",
              "portName": "out"
            }
          ]
        },
        "outputs": {
          "out": [
            {
              "nodeId": "sink",
              "portName": "in"
            }
          ]
        }
      }
    },
    "sink": {
      "id": "sink",
      "type": "data.Sink",
      "connections": {
        "inputs": {
          "in": [
            {
              "nodeId": "execution",
              "portName": "out"
            }
          ]
        },
        "outputs": {}
      }
    }
  }
}
