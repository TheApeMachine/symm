+		!(op.config.Lower <= op.config.Rest) ||
+		!(op.config.Rest <= op.config.Upper) ||
+		!(op.config.Window > 0) ||
+		floored != op.config.Window {
+		return core.ErrDomain
+	}
+
+	return nil
 }

