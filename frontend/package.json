{
  "name": "my-tanstack-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "git ls-files --cached --others --exclude-standard 'src/**/*.ts' 'src/**/*.tsx' 'vite.config.ts' 'vite.capnp-cjs-to-esm.ts' | grep -Ev '(^src/routeTree\\.gen\\.ts$|^src/lib/capnp/artifact\\.capnp\\.(js|d\\.ts)$)' | while IFS= read -r file; do [ -e \"$file\" ] && printf '%s\\n' \"$file\"; done | xargs biome lint",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/store": "^0.11.0",
    "capnp-ts": "0.7.0",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@biomejs/biome": "2.4.5",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
