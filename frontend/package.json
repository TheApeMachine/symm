{
  "name": "my-tanstack-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "git ls-files --cached --others --exclude-standard 'src/**/*.ts' 'src/**/*.tsx' 'vite.config.ts' | grep -Ev '(^src/routeTree\\.gen\\.ts$)' | while IFS= read -r file; do [ -e \"$file\" ] && printf '%s\\n' \"$file\"; done | xargs biome lint",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/store": "^0.11.0",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "flatbuffers": "^25.9.23",
    "lucide-react": "^1.27.0",
    "motion": "^11.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-use": "^17.6.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "three": "^0.185.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tauri-apps/cli": "^2.11.4",
    "@types/chroma-js": "^3.1.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
