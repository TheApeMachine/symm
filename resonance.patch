-	return RLSOutput{
-		Value:            reading.Prediction,
-		Scale:            reading.Scale,
-		DegreesOfFreedom: reading.DegreesOfFreedom,
-		Ready:            reading.Ready,
-		Innovation:       reading.Innovation,
-	}, nil
-}
