+
+type ResonanceConfig struct {
+	MaxInferenceSteps  int
+	MinInferenceSteps  int
+	LrState            float64
+	EarlyStopTol       float64
+	EarlyStopPatience  int
+	MonotoneStateSteps bool
+	LineSearchHalvings int
+
+	LrGenerative  float64
+	LrTemporal    float64
+	LrRecognition float64
